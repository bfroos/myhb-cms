{
  "kind": "collectionType",
  "collectionName": "blog_articles",
  "info": {
    "singularName": "blog-article",
    "pluralName": "blog-articles",
    "displayName": "Blog Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "internalLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "unique": true
    },
    "headline": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "targetField": "headline",
      "required": true
    },
    "displayDate": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::blog-category.blog-category"
    },
    "cover": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "intro": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "components": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "blocks.faq",
        "blocks.gallery",
        "blocks.faq-accordion",
        "blocks.media-card",
        "blocks.youtube-video",
        "blocks.media-bento",
        "blocks.benefits-list",
        "blocks.comparison-block",
        "blocks.directions",
        "blocks.employee",
        "blocks.employee-list",
        "blocks.highlights-strip",
        "blocks.location-map",
        "blocks.my-club",
        "blocks.page-header",
        "blocks.process-steps",
        "blocks.product-category-price-overview",
        "blocks.reviews",
        "blocks.stories",
        "blocks.table-of-contents",
        "blocks.text-content",
        "blocks.treatment-details",
        "blocks.treatment-hero",
        "blocks.treatment-plan",
        "blocks.treatment-teasers",
        "blocks.trust-grid",
        "blocks.landing-hero",
        "blocks.trust-bar",
        "blocks.quick-info",
        "blocks.before-after",
        "blocks.benefit-grid",
        "blocks.seo-collapsible",
        "blocks.doctor",
        "blocks.price-overview",
        "blocks.price-teaser",
        "blocks.local-section",
        "blocks.location-card",
        "blocks.final-cta",
        "blocks.mobile-sticky-cta",
        "blocks.landing-reviews",
        "blocks.press-logos",
        "blocks.guarantees",
        "blocks.awards",
        "blocks.live-counter",
        "blocks.promo-banner",
        "blocks.promo-strip",
        "blocks.promo-hero",
        "blocks.promo-floating-sticker",
        "blog.text",
        "blog.image",
        "blog.newsletter",
        "blog.cta"
      ]
    },
    "footnotes": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
